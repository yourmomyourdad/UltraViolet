#!/bin/bash

set -e

echo "======================================"
echo "   Ultraviolet-App Setup"
echo "======================================"
echo

# --------------------------------------
# 1. Make sure Node 24 is being used
# --------------------------------------

echo "[1/5] Checking Node.js..."

if ! command -v nvm >/dev/null 2>&1; then
    export NVM_DIR="$HOME/.nvm"

    if [ -s "$NVM_DIR/nvm.sh" ]; then
        . "$NVM_DIR/nvm.sh"
    fi
fi

nvm install 24
nvm use 24

echo "Node:"
node -v

# --------------------------------------
# 2. Get the official Ultraviolet-App
# --------------------------------------

echo "[2/5] Getting official Ultraviolet-App..."

TMP_DIR="$(mktemp -d)"

git clone --depth 1 \
    https://github.com/titaniumnetwork-dev/Ultraviolet-App.git \
    "$TMP_DIR/Ultraviolet-App"

# Copy the official application source.
rm -rf src
cp -r "$TMP_DIR/Ultraviolet-App/src" .

# Copy the official public files,
# but preserve YOUR index.html.
mkdir -p public

if [ -f "public/index.html" ]; then
    cp public/index.html "$TMP_DIR/your-index.html"
fi

rm -rf public
cp -r "$TMP_DIR/Ultraviolet-App/public" .

if [ -f "$TMP_DIR/your-index.html" ]; then
    cp "$TMP_DIR/your-index.html" public/index.html
fi

# Copy the official lockfile.
cp "$TMP_DIR/Ultraviolet-App/pnpm-lock.yaml" .

rm -rf "$TMP_DIR"

# --------------------------------------
# 3. Install dependencies
# --------------------------------------

echo "[3/5] Installing dependencies..."

corepack enable
corepack prepare pnpm@10.28.0 --activate

pnpm install

# --------------------------------------
# 4. Install Cloudflare Tunnel
# --------------------------------------

echo "[4/5] Installing Cloudflare Tunnel..."

if ! command -v cloudflared >/dev/null 2>&1; then

    curl -L \
        --output cloudflared \
        https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64

    chmod +x cloudflared

    sudo mv cloudflared /usr/local/bin/cloudflared

else
    echo "cloudflared already installed."
fi

# --------------------------------------
# 5. Create startup script
# --------------------------------------

echo "[5/5] Creating start.sh..."

cat > start.sh <<'EOF'
#!/bin/bash

set -e

echo "======================================"
echo "   Starting Ultraviolet-App"
echo "======================================"
echo

pnpm start &
SERVER_PID=$!

trap 'kill $SERVER_PID 2>/dev/null || true' EXIT

sleep 3

echo
echo "======================================"
echo "   Cloudflare Tunnel"
echo "======================================"
echo

cloudflared tunnel --url http://localhost:8080
EOF

chmod +x start.sh

echo
echo "======================================"
echo "Setup complete!"
echo "======================================"
echo
echo "Node:"
node -v
echo
echo "Run:"
echo "  ./start.sh"
echo
