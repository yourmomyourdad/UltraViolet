#!/bin/bash

set -e

echo "======================================"
echo "   Ultraviolet-App Setup"
echo "======================================"
echo

# --------------------------------------
# 1. Install Node.js 24
# --------------------------------------

echo "[1/4] Checking Node.js..."

NODE_MAJOR="$(node -v 2>/dev/null | sed 's/^v//' | cut -d. -f1 || echo 0)"

if [ "$NODE_MAJOR" -lt 24 ]; then
    echo "Installing Node.js 24..."

    curl -fsSL https://deb.nodesource.com/setup_24.x | sudo -E bash -
    sudo apt-get install -y nodejs
else
    echo "Node.js $(node -v) is already installed."
fi

echo "Node:"
node -v

# --------------------------------------
# 2. Get official Ultraviolet-App source
# --------------------------------------

echo "[2/4] Getting official Ultraviolet-App..."

TMP_DIR="$(mktemp -d)"

git clone --depth 1 \
    https://github.com/titaniumnetwork-dev/Ultraviolet-App.git \
    "$TMP_DIR/Ultraviolet-App"

# Official server
rm -rf src
cp -r "$TMP_DIR/Ultraviolet-App/src" .

# Official public files
mkdir -p public

# Preserve our custom index.html if it exists
CUSTOM_INDEX=""

if [ -f "public/index.html" ]; then
    CUSTOM_INDEX="$(mktemp)"
    cp public/index.html "$CUSTOM_INDEX"
fi

rm -rf public
cp -r "$TMP_DIR/Ultraviolet-App/public" .

if [ -n "$CUSTOM_INDEX" ]; then
    cp "$CUSTOM_INDEX" public/index.html
    rm -f "$CUSTOM_INDEX"
fi

# Official package files
cp "$TMP_DIR/Ultraviolet-App/package.json" .
cp "$TMP_DIR/Ultraviolet-App/pnpm-lock.yaml" .

rm -rf "$TMP_DIR"

# --------------------------------------
# 3. Install dependencies
# --------------------------------------

echo "[3/4] Installing dependencies..."

corepack enable
corepack prepare pnpm@10.28.0 --activate

pnpm install

# --------------------------------------
# 4. Cloudflare Tunnel
# --------------------------------------

echo "[4/4] Installing Cloudflare Tunnel..."

if ! command -v cloudflared >/dev/null 2>&1; then

    curl -L \
        --output cloudflared \
        https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64

    chmod +x cloudflared

    sudo mv cloudflared /usr/local/bin/cloudflared

else
    echo "cloudflared already installed."
fi

# --------------------------------------
# Startup script
# --------------------------------------

cat > start.sh <<'EOF'
#!/bin/bash

set -e

echo "======================================"
echo "   Starting Ultraviolet-App"
echo "======================================"
echo

pnpm start &
SERVER_PID=$!

trap 'kill $SERVER_PID 2>/dev/null || true' EXIT

sleep 3

echo
echo "======================================"
echo "   Cloudflare Tunnel"
echo "======================================"
echo

cloudflared tunnel --url http://localhost:8080
EOF

chmod +x start.sh

echo
echo "======================================"
echo "Setup complete!"
echo "======================================"
echo
echo "Node:"
node -v
echo
echo "Run:"
echo "  ./start.sh"
echo
