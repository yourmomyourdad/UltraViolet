#!/bin/bash
set -e

echo "======================================"
echo " UltraViolet + WebRTC Setup"
echo "======================================"

NODE_MAJOR="$(node -p 'Number(process.versions.node.split(".")[0])')"

if [ "$NODE_MAJOR" -lt 20 ]; then
  echo "Node 20+ required"
  exit 1
fi

echo "Node: $(node -v)"

echo
echo "[1/4] Syncing Scramjet-App source..."

TMP="$(mktemp -d)"

git clone --depth 1 \
  https://github.com/MercuryWorkshop/Scramjet-App.git \
  "$TMP/Scramjet-App"

# Preserve our custom frontend.
if [ -f public/index.html ]; then
  cp public/index.html "$TMP/custom-index.html"
fi

rm -rf src public

cp -r "$TMP/Scramjet-App/src" .
cp -r "$TMP/Scramjet-App/public" .

if [ -f "$TMP/custom-index.html" ]; then
  cp "$TMP/custom-index.html" public/index.html
fi

# Use the official Scramjet package configuration.
cp "$TMP/Scramjet-App/package.json" package.json

rm -rf "$TMP"

echo
echo "[2/4] Installing dependencies..."

corepack enable
corepack prepare pnpm@10.18.3 --activate

pnpm install

# Add our WebRTC dependency.
pnpm add @roamhq/wrtc

# Add our agent command.
pnpm pkg set scripts.agent="node agent.mjs"

echo
echo "[3/4] Installing Eruda..."

python3 - <<'PY'
from pathlib import Path

path = Path("public/index.html")

if path.exists():
    html = path.read_text(encoding="utf-8")

    if "cdn.jsdelivr.net/npm/eruda" not in html:
        marker = "</head>"
        pos = html.lower().find(marker)

        if pos != -1:
            eruda = """
<script src="https://cdn.jsdelivr.net/npm/eruda"></script>
<script>
  eruda.init();
</script>
"""
            html = html[:pos] + eruda + html[pos:]
            path.write_text(html, encoding="utf-8")

print("Eruda: VERIFIED")
PY

echo
echo "[4/4] Creating start script..."

cat > start.sh <<'EOF'
#!/bin/bash
set -e

echo "======================================"
echo " Starting Scramjet + WebRTC"
echo "======================================"

pnpm start &
SCRAMJET_PID=$!

sleep 3

pnpm run agent &
AGENT_PID=$!

cleanup() {
  kill "$AGENT_PID" 2>/dev/null || true
  kill "$SCRAMJET_PID" 2>/dev/null || true
}

trap cleanup EXIT INT TERM

wait
EOF

chmod +x start.sh

echo
echo "======================================"
echo " Setup complete!"
echo "======================================"
echo
echo "Run:"
echo "  ./start.sh"
echo
