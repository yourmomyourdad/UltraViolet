#!/bin/bash

set -e

echo "=== Ultraviolet + Wisp setup ==="

# Clone Ultraviolet if it isn't already here
if [ ! -d "Ultraviolet" ]; then
    echo "[1/4] Cloning Ultraviolet..."
    git clone https://github.com/titaniumnetwork-dev/Ultraviolet.git
else
    echo "[1/4] Ultraviolet already exists."
fi

# Install UV dependencies and build it
echo "[2/4] Installing Ultraviolet..."
cd Ultraviolet
npm install

echo "[3/4] Building Ultraviolet..."
npm run build

cd ..

# Install the root server dependencies
echo "[4/4] Installing Wisp server..."
npm install

echo ""
echo "=== Setup complete! ==="
echo ""
echo "Start the server with:"
echo "  npm start"
echo ""
