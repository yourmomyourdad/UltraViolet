#!/bin/bash
set -e

echo "======================================"
echo "   UltraViolet Codespace Setup"
echo "======================================"
echo

echo "[1/4] Checking Node.js..."

NODE_MAJOR="$(node -p 'Number(process.versions.node.split(".")[0])' 2>/dev/null || echo 0)"

if [ "$NODE_MAJOR" -lt 20 ]; then
    echo "Node 20+ is required."
    exit 1
fi

echo "Node: $(node -v)"

echo
echo "[2/4] Syncing official Scramjet-App source..."

TMP="$(mktemp -d)"

git clone --depth 1 \
    https://github.com/MercuryWorkshop/Scramjet-App.git \
    "$TMP/Scramjet-App"

# Preserve our custom frontend.
OLD_INDEX=""

if [ -f public/index.html ]; then
    OLD_INDEX="$(mktemp)"
    cp public/index.html "$OLD_INDEX"
fi

# Replace only the official application source.
rm -rf src public

cp -r "$TMP/Scramjet-App/src" .
cp -r "$TMP/Scramjet-App/public" .

# Restore our custom frontend.
if [ -n "$OLD_INDEX" ]; then
    cp "$OLD_INDEX" public/index.html
    rm -f "$OLD_INDEX"
fi

rm -rf "$TMP"

echo
echo "[3/4] Installing dependencies..."

corepack enable
corepack prepare pnpm@10.18.3 --activate

pnpm install

echo
echo "[4/4] Installing Eruda..."

python3 - <<'PY'
from pathlib import Path

path = Path("public/index.html")

if path.exists():
    html = path.read_text(encoding="utf-8")

    if "cdn.jsdelivr.net/npm/eruda" not in html:
        marker = "</head>"
        pos = html.lower().find(marker)

        if pos != -1:
            eruda = """
<script src="https://cdn.jsdelivr.net/npm/eruda"></script>
<script>
  eruda.init();
</script>
"""
            html = html[:pos] + eruda + html[pos:]

            path.write_text(
                html,
                encoding="utf-8"
            )

print("Eruda: VERIFIED")
PY

cat > start.sh <<'EOF'
#!/bin/bash
set -e

echo "======================================"
echo "   Starting Scramjet + WebRTC"
echo "======================================"
echo

echo "Starting Scramjet/Wisp..."

pnpm start &
SCRAMJET_PID=$!

sleep 3

echo
echo "Starting WebRTC agent..."

pnpm run agent &
AGENT_PID=$!

cleanup() {
    echo
    echo "Stopping services..."

    kill "$AGENT_PID" 2>/dev/null || true
    kill "$SCRAMJET_PID" 2>/dev/null || true
}

trap cleanup EXIT INT TERM

wait
EOF

chmod +x start.sh

echo
echo "======================================"
echo "   Setup Complete!"
echo "======================================"
echo
echo "Run:"
echo
echo "  ./start.sh"
echo
echo "This starts:"
echo
echo "  Scramjet/Wisp"
echo "  WebRTC agent"
echo
echo "No cloudflared tunnel is used."
echo
