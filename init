#!/bin/bash

set -e

echo "======================================"
echo "   Ultraviolet + Wisp Setup"
echo "======================================"
echo

if [ ! -d "Ultraviolet" ]; then
    echo "[1/4] Cloning Ultraviolet..."
    git clone https://github.com/titaniumnetwork-dev/Ultraviolet.git
else
    echo "[1/4] Ultraviolet already exists."
fi

echo "[2/4] Building Ultraviolet..."

cd Ultraviolet
npm install
npm run build
cd ..

echo "[3/4] Installing application dependencies..."

npm install

echo "[4/4] Installing Cloudflare Tunnel..."

if ! command -v cloudflared >/dev/null 2>&1; then
    curl -L \
      --output cloudflared \
      https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64

    chmod +x cloudflared
    sudo mv cloudflared /usr/local/bin/cloudflared
fi

cat > start.sh <<'EOF'
#!/bin/bash

set -e

npm start &
SERVER_PID=$!

trap 'kill $SERVER_PID 2>/dev/null || true' EXIT

sleep 2

echo
echo "======================================"
echo "   Cloudflare Tunnel"
echo "======================================"
echo

cloudflared tunnel --url http://localhost:8080
EOF

chmod +x start.sh

echo
echo "======================================"
echo "Setup complete!"
echo "======================================"
echo
echo "Run:"
echo "  ./start.sh"
